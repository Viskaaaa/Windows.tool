<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ViskaTweak</RootNamespace>
    <AssemblyName>ViskaTweak</AssemblyName>

    <!-- Single-file self-contained publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Off deliberately. Compressed bundles have been a source of assemblies failing to resolve
         at runtime, which is exactly the failure seen with XDocument and Regex. A larger exe is
         a fair trade for one that loads what it needs. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Trimming is OFF on purpose: WPF + System.Management reflect heavily. -->
    <PublishTrimmed>false</PublishTrimmed>

    <Version>1.0.0</Version>
    <Product>Viska Tweak</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>Viska Tweak</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same icon for the exe and for every window's title bar. -->
    <Resource Include="app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Encrypted license table, baked into the exe. Generate with tools/LicenseGen.
         Absolute path and explicit LogicalName so the manifest name cannot drift with
         RootNamespace or the directory the build was launched from. -->
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/licenses.dat"
                      LogicalName="ViskaTweak.licenses.dat"
                      Condition="Exists('$(MSBuildProjectDirectory)/licenses.dat')" />
  </ItemGroup>

  <!-- Fail the build loudly instead of shipping an exe that cannot activate anyone. -->
  <Target Name="RequireLicenseTable" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/licenses.dat')"
           Text="licenses.dat is missing, so nobody could activate this build. Generate it first:&#xA;  dotnet run --project tools/LicenseGen -- pack YOUR-SECRET users.txt src/ViskaTweak/licenses.dat" />
  </Target>

</Project>

<UserControl x:Class="ViskaTweak.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ViskaTweak.Controls"
             AutomationProperties.Name="Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>

            <!-- Header + tier badge -->
            <Grid Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.H1}" Text="Hardware detected"/>
                    <TextBlock x:Name="CpuNameText" Style="{StaticResource Text.Label}" Text="Reading your system…"/>
                </StackPanel>
                <Border x:Name="TierPill" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Background="{DynamicResource Brush.WarningBg}">
                    <TextBlock x:Name="TierText" Text="Detecting…" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Warning}"
                               AutomationProperties.Name="Performance tier"/>
                </Border>
            </Grid>

            <!-- GPU / RAM / CPU, the last two with live load meters -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.Hover}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="GPU"/>
                        <TextBlock x:Name="GpuText" Style="{StaticResource Text.H2}" Margin="0,4,0,0" Text="…"
                                   AutomationProperties.Name="Graphics card"/>
                        <TextBlock x:Name="VramText" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card.Hover}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource Text.Label}" Text="RAM"/>
                            <TextBlock x:Name="RamLoadText" Style="{StaticResource Text.Label}"
                                       HorizontalAlignment="Right" Text="—"/>
                        </Grid>
                        <TextBlock x:Name="RamText" Style="{StaticResource Text.H2}" Margin="0,4,0,8" Text="…"
                                   AutomationProperties.Name="System memory"/>
                        <ProgressBar x:Name="RamMeter" Style="{StaticResource Meter}"
                                     AutomationProperties.Name="Memory in use, percent"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card.Hover}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource Text.Label}" Text="CPU"/>
                            <TextBlock x:Name="CpuLoadText" Style="{StaticResource Text.Label}"
                                       HorizontalAlignment="Right" Text="—"/>
                        </Grid>
                        <TextBlock x:Name="CpuText" Style="{StaticResource Text.H2}" Margin="0,4,0,8" Text="…"
                                   AutomationProperties.Name="Processor"/>
                        <ProgressBar x:Name="CpuMeter" Style="{StaticResource Meter}"
                                     AutomationProperties.Name="Processor load, percent"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FPS gauge + junk breakdown -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.Hover}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H2}" Text="FPS estimate"/>
                        <TextBlock Style="{StaticResource Text.Label}" Margin="0,2,0,0"
                                   Text="Estimated from your hardware and the settings applied — not a measurement."/>

                        <Grid Height="200" Margin="0,12,0,0">
                            <c:ArcGauge x:Name="FpsGauge" ArcThickness="14"
                                        TrackBrush="{DynamicResource Brush.CardAlt}"
                                        ValueBrush="{DynamicResource Brush.Accent}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="AfterText" Text="—" FontSize="{DynamicResource Font.Huge}"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Success}"
                                           AutomationProperties.Name="Estimated FPS after"/>
                                <TextBlock Style="{StaticResource Text.Label}" Text="FPS estimated"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Before  "/>
                                <TextBlock x:Name="BeforeText" Text="—" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           AutomationProperties.Name="Estimated FPS before"/>
                            </StackPanel>
                            <Border x:Name="GainPill" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                    Padding="10,4" MinHeight="0" Background="{DynamicResource Brush.SuccessBg}">
                                <TextBlock x:Name="GainText" Text="not applied" FontWeight="SemiBold"
                                           FontSize="{DynamicResource Font.Small}"
                                           Foreground="{DynamicResource Brush.Success}"
                                           AutomationProperties.Name="Estimated gain"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="FpsNote" Style="{StaticResource Text.Label}" Margin="0,10,0,0"
                                   Text="Apply a preset in Game optimizer to see the projected figure."/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card.Hover}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Text.H2}" Text="Junk found"/>
                            <TextBlock x:Name="JunkTotal" HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="Scanning…" AutomationProperties.Name="Total reclaimable space"/>
                        </Grid>

                        <Button x:Name="ReviewButton" DockPanel.Dock="Bottom" Content="Review and clean"
                                Margin="0,16,0,0" Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Stretch" Click="Review_Click" IsEnabled="False"
                                AutomationProperties.Name="Review and clean, opens the cache cleaner"/>

                        <ItemsControl x:Name="JunkChart" Margin="0,14,0,0" Focusable="False"
                                      AutomationProperties.Name="Reclaimable space by category">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Label}"/>
                                            <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding Percent}"
                                                     AutomationProperties.Name="{Binding Label}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

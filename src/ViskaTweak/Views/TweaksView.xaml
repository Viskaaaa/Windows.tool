<UserControl x:Class="ViskaTweak.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Tweaks">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>

            <TextBlock Style="{StaticResource Text.H1}" Text="Boost tools"/>
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,4"
                       Text="One-click tweaks for raw speed and steady frames. Every one of these changes something you can go and check yourself — the exact registry key or folder is written into Activity."/>
            <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,14"
                       Text="Cards marked ADMIN change system-wide settings and need the app run as administrator."/>

            <Border x:Name="StatusBox" Style="{StaticResource Pill}" Visibility="Collapsed"
                    Background="{DynamicResource Brush.CardAlt}" Margin="0,0,0,14">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Tweak status"/>
            </Border>

            <ItemsControl x:Name="TweakList" Focusable="False"
                          AutomationProperties.Name="Available tweaks">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card.Hover}" Width="252" Margin="0,0,12,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Icon}" FontSize="{DynamicResource Font.H2}"
                                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Width="176"/>
                                    </StackPanel>

                                    <Border Style="{StaticResource Pill}" Padding="6,2" MinHeight="0"
                                            HorizontalAlignment="Left" Margin="0,0,0,8"
                                            Background="{DynamicResource Brush.WarningBg}"
                                            Visibility="{Binding AdminBadge}">
                                        <TextBlock Text="ADMIN" FontSize="{DynamicResource Font.Small}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Warning}"/>
                                    </Border>

                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Label}"
                                               Margin="0,0,0,12" MinHeight="72" VerticalAlignment="Top"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom">
                                    <Button Content="Apply tweak" Style="{StaticResource Button.Primary}"
                                            HorizontalAlignment="Stretch" Tag="{Binding}" Click="Apply_Click"
                                            AutomationProperties.Name="{Binding ApplyLabel}"/>
                                    <Button Content="Undo" Style="{StaticResource Button.Ghost}" Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch" Tag="{Binding}" Click="Undo_Click"
                                            Visibility="{Binding UndoVisibility}"
                                            AutomationProperties.Name="{Binding UndoLabel}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Meet our devs -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="Meet our devs"/>
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,2,0,14"
                               Text="Built by people who play on the same hardware you do."/>

                    <Border Background="{DynamicResource Brush.CardAlt}" CornerRadius="10" Padding="14"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="54" Height="54" CornerRadius="27" Margin="0,0,14,0">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.34,0.28" GradientOrigin="0.34,0.28"
                                                         RadiusX="0.95" RadiusY="0.95">
                                        <GradientStop Color="{DynamicResource Color.Accent}" Offset="0"/>
                                        <GradientStop Color="#220608" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <TextBlock Text="V" FontSize="{DynamicResource Font.H1}" FontWeight="Bold"
                                           Foreground="#FFF1EF" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="viska.dv" FontWeight="SemiBold"
                                           FontSize="{DynamicResource Font.H2}"
                                           AutomationProperties.Name="viska.dv, developer"/>
                                <TextBlock Text="Creator and lead developer" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="Viska Tweak" Style="{StaticResource Text.Label}"
                                           Foreground="{DynamicResource Brush.Accent}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

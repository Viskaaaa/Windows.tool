<UserControl x:Class="ViskaTweak.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="License and appearance">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>

            <TextBlock Style="{StaticResource Text.H1}" Text="License and appearance"/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="License"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.SuccessBg}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2713;" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Success}"/>
                                <TextBlock x:Name="LicenseStatus" Text="Activated"
                                           Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold"
                                           AutomationProperties.Name="License status"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,10,0,12"
                               Text="Deactivating forgets the key on this PC and closes the app. You will need the username and key again next launch."/>
                    <Button Content="Deactivate this PC" Style="{StaticResource Button.Ghost}"
                            HorizontalAlignment="Left" Click="Deactivate_Click"
                            AutomationProperties.Name="Deactivate this PC and close the app"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource Text.H2}" Text="Install on this PC"/>
                        <Border x:Name="InstallPill" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                Padding="10,4" MinHeight="0" Background="{DynamicResource Brush.CardAlt}">
                            <TextBlock x:Name="InstallState" Text="Checking…" FontWeight="SemiBold"
                                       FontSize="{DynamicResource Font.Small}"
                                       AutomationProperties.Name="Install status"/>
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,2,0,10"
                               Text="Copies the app into your user folder, adds a Start menu and desktop shortcut, and lists it in Add or Remove Programs. All per-user — no administrator rights needed."/>
                    <TextBlock x:Name="InstallPath" Style="{StaticResource Text.Label}" Margin="0,0,0,10"/>

                    <CheckBox x:Name="DesktopCheck" IsChecked="True" Content="Also put a shortcut on the desktop"
                              AutomationProperties.Name="Also create a desktop shortcut"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="InstallButton" Content="Install" Style="{StaticResource Button.Primary}"
                                Margin="0,0,10,0" Click="Install_Click"
                                AutomationProperties.Name="Install on this PC"/>
                        <Button Content="Uninstall" Style="{StaticResource Button.Ghost}" Click="Uninstall_Click"
                                AutomationProperties.Name="Remove shortcuts and the Add or Remove Programs entry"/>
                    </StackPanel>

                    <Border x:Name="InstallStatusBox" Style="{StaticResource Pill}" Visibility="Collapsed"
                            Background="{DynamicResource Brush.CardAlt}" Margin="0,12,0,0">
                        <TextBlock x:Name="InstallStatusText" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Install status message"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="Background"/>
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,2,0,8"
                               Text="Keep tracking FiveM after you close the window. Sessions and changes are saved either way — this only decides whether tracking continues while the window is shut."/>

                    <CheckBox x:Name="KeepRunningCheck" Content="Keep running in the tray when I close the window"
                              Checked="Background_Changed" Unchecked="Background_Changed"
                              AutomationProperties.Name="Keep running in the notification area when the window is closed"
                              AutomationProperties.HelpText="Exit from the tray icon's right-click menu closes it fully."/>
                    <CheckBox x:Name="NotifyCheck" Content="Notify me when FiveM starts and stops"
                              Checked="Background_Changed" Unchecked="Background_Changed"
                              AutomationProperties.Name="Notify me when FiveM starts and stops"/>
                    <CheckBox x:Name="StartupCheck" Content="Start with Windows, straight to the tray"
                              Checked="Startup_Changed" Unchecked="Startup_Changed"
                              AutomationProperties.Name="Start with Windows, opening straight to the tray"
                              AutomationProperties.HelpText="Adds a per-user startup entry. No administrator rights needed."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="Appearance"/>

                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,12,0,4" Text="Theme"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RedRadio" Content="Dark red" GroupName="Theme" Margin="0,0,20,0"
                                     Checked="Theme_Changed" AutomationProperties.Name="Dark red theme"/>
                        <RadioButton x:Name="ContrastRadio" Content="High contrast" GroupName="Theme"
                                     Checked="Theme_Changed" AutomationProperties.Name="High contrast theme"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,16,0,4" Text="Motion"/>
                    <CheckBox x:Name="EffectsCheck" Content="Cursor glow and page animations"
                              Checked="Effects_Changed" Unchecked="Effects_Changed"
                              AutomationProperties.Name="Cursor glow and page animations"
                              AutomationProperties.HelpText="Turn off to remove all movement from the interface. Always off in the high contrast theme."/>

                    <TextBlock x:Name="ScaleLabel" Style="{StaticResource Text.Label}" Margin="0,16,0,4"
                               Text="Text size: 100%"/>
                    <Slider x:Name="ScaleSlider" Minimum="0.85" Maximum="1.75" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.15"
                            Width="320" HorizontalAlignment="Left"
                            ValueChanged="Scale_Changed"
                            AutomationProperties.Name="Text size"
                            AutomationProperties.HelpText="Arrow keys adjust in 5 percent steps, from 85 to 175 percent."/>

                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,16,0,0"
                               Text="Keyboard: Tab moves between controls, Enter or Space activates, Escape closes dialogs, Ctrl+1 to Ctrl+6 jump between pages."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

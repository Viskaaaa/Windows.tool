<Window x:Class="ViskaTweak.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ViskaTweak.Controls"
        Title="Viska Tweak — activation"
        Icon="/app.ico"
        Width="520" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        MouseMove="Window_MouseMove"
        AutomationProperties.Name="Viska Tweak activation"
        FocusManager.FocusedElement="{Binding ElementName=KeyBox}">

    <Grid>
        <!-- Same drifting constellation as the main window. -->
        <c:ParticleField Accent="{DynamicResource Color.Accent}"/>

        <Grid Margin="36,32,36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mark + wordmark -->
            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                <Border Width="76" Height="76" CornerRadius="18" HorizontalAlignment="Center">
                    <Border.Background>
                        <RadialGradientBrush Center="0.34,0.28" GradientOrigin="0.34,0.28" RadiusX="0.95" RadiusY="0.95">
                            <GradientStop Color="{DynamicResource Color.Accent}" Offset="0"/>
                            <GradientStop Color="#220608" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Viewbox Margin="18">
                        <Path Data="M79 20 L46 75 h20 l-8 45 l36 -57 h-20 z" Fill="#FFF1EF"/>
                    </Viewbox>
                </Border>

                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0"
                           FontSize="{DynamicResource Font.H1}" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text}" Text="Viska Tweak"/>
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Label}"
                           Text="FPS · CACHE · RESHADE"/>
            </StackPanel>

            <!-- Key entry -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="KeyLabel" HorizontalAlignment="Center" Margin="0,0,0,10"
                           Style="{StaticResource Text.Secondary}"
                           Text="Enter your access key"/>

                <Border Background="{DynamicResource Brush.CardAlt}" CornerRadius="12"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <TextBox x:Name="KeyBox" MaxLength="32" Background="Transparent" BorderThickness="0"
                             Padding="0,14" MinHeight="58"
                             FontSize="{DynamicResource Font.H1}" FontWeight="Bold"
                             HorizontalContentAlignment="Center" TextAlignment="Center"
                             PreviewTextInput="KeyBox_PreviewTextInput"
                             AutomationProperties.Name="Access key"
                             AutomationProperties.LabeledBy="{Binding ElementName=KeyLabel}"
                             AutomationProperties.HelpText="Six digits, for example 111111. Letters are allowed too and capitals do not matter."/>
                </Border>

                <Expander Margin="0,14,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                          AutomationProperties.Name="Username, optional">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource Text.Label}" Text="Add a username (optional)"/>
                    </Expander.Header>
                    <TextBox x:Name="UserBox" Margin="0,10,0,0" MaxLength="64"
                             AutomationProperties.Name="Username, optional"
                             AutomationProperties.HelpText="Leave blank unless you were given one. The key alone is enough."/>
                </Expander>

                <CheckBox x:Name="RememberBox" IsChecked="True" Margin="0,10,0,0"
                          Content="Stay signed in on this PC"
                          AutomationProperties.Name="Stay signed in on this PC"/>

                <!-- Icon as well as colour, and announced the moment it changes. -->
                <Border x:Name="ErrorBox" Style="{StaticResource Pill}" Visibility="Collapsed"
                        Background="{DynamicResource Brush.CardAlt}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x26A0;" Margin="0,0,8,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource Brush.Danger}"/>
                        <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   AutomationProperties.LiveSetting="Assertive"
                                   AutomationProperties.Name="Activation error"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Button x:Name="ActivateButton" Content="Unlock" Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Stretch" MinHeight="48" IsDefault="True" Click="Activate_Click"
                        AutomationProperties.Name="Unlock"/>
                <Button Content="Quit" Style="{StaticResource Button.Ghost}" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" IsCancel="True" Click="Quit_Click"
                        AutomationProperties.Name="Quit without activating"/>
            </StackPanel>
        </Grid>

        <!-- Cursor glow, matching the main window. -->
        <Border x:Name="CursorGlow" IsHitTestVisible="False" Opacity="0.45">
            <Border.Background>
                <RadialGradientBrush x:Name="GlowBrush" RadiusX="0.35" RadiusY="0.35"
                                     Center="0.5,0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#38E4544F" Offset="0"/>
                    <GradientStop Color="#00E4544F" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</Window>

<Window x:Class="ViskaTweak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ViskaTweak.Controls"
        Title="Viska Tweak"
        Icon="/app.ico" Height="760" Width="1120" MinHeight="560" MinWidth="880"
        Background="{DynamicResource Brush.Window}"
        MouseMove="Window_MouseMove"
        AutomationProperties.Name="Viska Tweak main window">

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="4"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="5"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="6"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static NavigationCommands.GoToPage}" Executed="GoToPage_Executed"/>
    </Window.CommandBindings>

    <Grid>
        <!-- Drifting constellation behind the whole app. Cards above it are slightly
             translucent, so it reads through without competing with the text. -->
        <c:ParticleField Accent="{DynamicResource Color.Accent}"/>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Sidebar}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="6,8,6,18">
                        <TextBlock Style="{StaticResource Text.H1}" Text="Viska Tweak"
                                   Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Style="{StaticResource Text.Label}" Text="Game and FiveM optimizer"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="6,16,6,4">
                        <TextBlock x:Name="LicenseFooter" Style="{StaticResource Text.Label}" Text="Activated"/>
                        <TextBlock x:Name="WatcherFooter" Style="{StaticResource Text.Label}" Text="FiveM: not running"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="FiveM background status"/>
                    </StackPanel>

                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="Nav_SelectionChanged"
                             KeyboardNavigation.TabNavigation="Once"
                             AutomationProperties.Name="Main navigation">
                        <ListBoxItem Content="Dashboard"      AutomationProperties.Name="Dashboard, page 1 of 7. Shortcut Control 1."/>
                        <ListBoxItem Content="Cache cleaner"  AutomationProperties.Name="Cache cleaner, page 2 of 7. Shortcut Control 2."/>
                        <ListBoxItem Content="Game optimizer" AutomationProperties.Name="Game optimizer, page 3 of 7. Shortcut Control 3."/>
                        <ListBoxItem Content="FPS boost"      AutomationProperties.Name="FPS boost, page 4 of 7. Shortcut Control 4."/>
                        <ListBoxItem Content="Boost tools"    AutomationProperties.Name="Boost tools, page 5 of 7. Shortcut Control 5."/>
                        <ListBoxItem Content="Activity"       AutomationProperties.Name="Activity, page 6 of 7. Shortcut Control 6."/>
                        <ListBoxItem Content="License"        AutomationProperties.Name="License and appearance, page 7 of 7. Shortcut Control 7."/>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl x:Name="Host" Grid.Column="1" Margin="16,0,0,0"
                            RenderTransformOrigin="0.5,0.5"
                            AutomationProperties.Name="Page content">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="HostShift"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Cursor glow. Sits above everything but takes no hits, so it never intercepts a click.
             Hidden entirely under high contrast or when effects are switched off. -->
        <Border x:Name="CursorGlow" IsHitTestVisible="False" Opacity="0.5">
            <Border.Background>
                <RadialGradientBrush x:Name="GlowBrush" RadiusX="0.22" RadiusY="0.30"
                                     Center="0.5,0.5" GradientOrigin="0.5,0.5">
                    <GradientStop x:Name="GlowInner" Color="#38E4544F" Offset="0"/>
                    <GradientStop Color="#00E4544F" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="FiveMTweaks.Views.BoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="FPS boost">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>

            <TextBlock Style="{StaticResource Text.H1}" Text="FPS boost"/>
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,16"
                       Text="Frame-time fixes aimed at FiveM. Everything here is per-user and reversible — no administrator rights, nothing system-wide."/>

            <Border x:Name="StatusBox" Style="{StaticResource Pill}" Visibility="Collapsed"
                    Background="{DynamicResource Brush.CardAlt}" Margin="0,0,0,12" HorizontalAlignment="Left">
                <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Status"/>
            </Border>

            <!-- FiveM tweaks -->
            <Border Style="{StaticResource Card.Hover}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="FiveM"/>
                    <TextBlock x:Name="FiveMPath" Style="{StaticResource Text.Label}" Margin="0,2,0,12"
                               Text="Looking for FiveM…"/>

                    <Grid Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                            <TextBlock Text="Turn off fullscreen optimisations" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Text.Label}"
                                       Text="Removes the compositor Windows puts in front of fullscreen games. This is the stutter fix — it evens out frame times rather than raising the average."/>
                        </StackPanel>
                        <Button Content="Apply" Style="{StaticResource Button.Ghost}" MinWidth="130"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="Fso_Click"
                                AutomationProperties.Name="Turn off fullscreen optimisations for FiveM"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                            <TextBlock Text="Use the high-performance GPU" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Text.Label}"
                                       Text="On a laptop with two graphics chips, pins FiveM to the fast one instead of the integrated GPU."/>
                        </StackPanel>
                        <Button Content="Apply" Style="{StaticResource Button.Ghost}" MinWidth="130"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="Gpu_Click"
                                AutomationProperties.Name="Set FiveM to use the high-performance GPU"/>
                    </Grid>

                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                            <TextBlock Text="Boost the running game" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Text.Label}"
                                       Text="Raises FiveM's process priority while it is open. Above normal, not High — High starves the audio and input threads and feels worse."/>
                        </StackPanel>
                        <Button Content="Boost now" Style="{StaticResource Button.Primary}" MinWidth="130"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="Boost_Click"
                                AutomationProperties.Name="Boost the running FiveM process now"/>
                    </Grid>

                    <Button Content="Undo FiveM tweaks" Style="{StaticResource Button.Ghost}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="UndoFiveM_Click"
                            AutomationProperties.Name="Undo the FiveM tweaks"/>
                </StackPanel>
            </Border>

            <!-- ReShade -->
            <Border Style="{StaticResource Card.Hover}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource Text.H2}" Text="ReShade"/>
                        <Border x:Name="ReShadePill" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                Padding="10,4" MinHeight="0" Background="{DynamicResource Brush.CardAlt}">
                            <TextBlock x:Name="ReShadeState" Text="Checking…" FontWeight="SemiBold"
                                       FontSize="{DynamicResource Font.Small}"
                                       AutomationProperties.Name="ReShade status"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ReShadePath" Style="{StaticResource Text.Label}" Margin="0,2,0,12"/>

                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,10"
                               Text="Straight answer: ReShade costs frames, it never adds them. These options make it cheaper, or switch it off."/>

                    <!-- Read back from disk after every action, so a change is visible rather than
                         having to be taken on trust. -->
                    <Border Background="{DynamicResource Brush.CardAlt}" CornerRadius="8" Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel AutomationProperties.Name="Current ReShade settings">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Performance mode"/>
                                <TextBlock x:Name="PerfState" HorizontalAlignment="Right" Text="—"
                                           FontWeight="SemiBold" FontSize="{DynamicResource Font.Small}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Effects enabled"/>
                                <TextBlock x:Name="EffectState" HorizontalAlignment="Right" Text="—"
                                           FontWeight="SemiBold" FontSize="{DynamicResource Font.Small}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource Text.Label}" Text="Active preset"/>
                                <TextBlock x:Name="PresetState" HorizontalAlignment="Right" Text="—"
                                           FontWeight="SemiBold" FontSize="{DynamicResource Font.Small}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,10"
                               Text="Close FiveM before changing anything here. ReShade rewrites its own config when the game exits, and will undo edits made while it is running. Changes apply on the next launch."/>

                    <WrapPanel x:Name="ReShadeButtons">
                        <Button Content="Performance mode" Style="{StaticResource Button.Ghost}" Margin="0,0,10,10"
                                Click="Perf_Click"
                                AutomationProperties.Name="Turn on ReShade performance mode"
                                AutomationProperties.HelpText="Keeps your effects but removes per-frame overhead."/>
                        <Button Content="Strip heavy effects" Style="{StaticResource Button.Ghost}" Margin="0,0,10,10"
                                Click="Strip_Click"
                                AutomationProperties.Name="Remove expensive effects from the preset"
                                AutomationProperties.HelpText="Drops ray tracing, ambient occlusion, bloom and depth of field."/>
                        <Button x:Name="ToggleButton" Content="Turn ReShade off" Style="{StaticResource Button.Primary}"
                                Margin="0,0,10,10" Click="Toggle_Click"
                                AutomationProperties.Name="Turn ReShade off"/>
                        <Button Content="Restore ReShade files" Style="{StaticResource Button.Ghost}" Margin="0,0,0,10"
                                Click="RestoreReShade_Click"
                                AutomationProperties.Name="Restore the original ReShade files"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

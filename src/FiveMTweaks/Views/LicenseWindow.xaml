<Window x:Class="FiveMTweaks.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FiveM Tweaks — activation"
        Icon="/app.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        AutomationProperties.Name="FiveM Tweaks activation"
        FocusManager.FocusedElement="{Binding ElementName=UserBox}">

    <Border Style="{StaticResource Card}" Margin="20" Padding="24">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.H1}" Text="Activate FiveM Tweaks"/>
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,20"
                       Text="Enter the username and key you were given."/>

            <TextBlock x:Name="UserLabel" Style="{StaticResource Text.Label}" Text="Username"/>
            <TextBox x:Name="UserBox" Margin="0,4,0,14" MaxLength="64"
                     AutomationProperties.Name="Username"
                     AutomationProperties.LabeledBy="{Binding ElementName=UserLabel}"/>

            <TextBlock x:Name="KeyLabel" Style="{StaticResource Text.Label}" Text="License key"/>
            <TextBox x:Name="KeyBox" Margin="0,4,0,14" MaxLength="32"
                     FontSize="{DynamicResource Font.H2}"
                     PreviewTextInput="KeyBox_PreviewTextInput"
                     AutomationProperties.Name="License key"
                     AutomationProperties.LabeledBy="{Binding ElementName=KeyLabel}"
                     AutomationProperties.HelpText="Letters and numbers, 4 to 32 characters. Capitals do not matter."/>

            <CheckBox x:Name="RememberBox" IsChecked="True" Content="Stay activated on this PC"
                      AutomationProperties.Name="Stay activated on this PC"/>

            <!-- Error text carries an icon glyph as well as colour, and is announced when it changes. -->
            <Border x:Name="ErrorBox" Style="{StaticResource Pill}" Visibility="Collapsed"
                    Background="{DynamicResource Brush.CardAlt}" Margin="0,12,0,0">
                <!-- Grid, not a horizontal StackPanel: the star column bounds the text so a long
                     message wraps instead of being clipped by the window edge. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x26A0;" Margin="0,0,8,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource Brush.Danger}"/>
                    <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Danger}"
                               AutomationProperties.LiveSetting="Assertive"
                               AutomationProperties.Name="Activation error"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Quit" Style="{StaticResource Button.Ghost}" IsCancel="True"
                        Margin="0,0,10,0" Click="Quit_Click"
                        AutomationProperties.Name="Quit without activating"/>
                <Button x:Name="ActivateButton" Content="Activate" Style="{StaticResource Button.Primary}"
                        IsDefault="True" Click="Activate_Click"
                        AutomationProperties.Name="Activate"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

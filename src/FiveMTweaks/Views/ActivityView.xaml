<UserControl x:Class="FiveMTweaks.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Activity">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H1}" Text="Activity"/>
                    <TextBlock Style="{StaticResource Text.Label}"
                               Text="What FiveM is doing, and everything this tool has changed on this PC."/>
                </StackPanel>
                <Border x:Name="LivePill" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Background="{DynamicResource Brush.CardAlt}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="9" Height="9" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock x:Name="LiveText" Text="Not running" FontWeight="SemiBold"
                                   AutomationProperties.Name="FiveM status"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live FiveM status -->
            <Border Style="{StaticResource Card.Hover}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="FiveM right now"/>
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,2,0,14"
                               Text="Read from the process from outside the game — memory, processor and uptime. Not an overlay, so it cannot report in-game FPS."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="Session"/>
                            <TextBlock x:Name="UptimeText" Style="{StaticResource Text.H2}" Text="—"
                                       AutomationProperties.Name="Session length"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Memory"/>
                            <TextBlock x:Name="MemoryText" Style="{StaticResource Text.H2}" Text="—"
                                       AutomationProperties.Name="Memory in use by FiveM"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Peak memory"/>
                            <TextBlock x:Name="PeakText" Style="{StaticResource Text.H2}" Text="—"
                                       AutomationProperties.Name="Peak memory this session"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Processor"/>
                            <TextBlock x:Name="CpuText" Style="{StaticResource Text.H2}" Text="—"
                                       AutomationProperties.Name="Processor use by FiveM"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="MemoryMeter" Style="{StaticResource Meter}" Margin="0,14,0,0"
                                 AutomationProperties.Name="FiveM memory against total system memory"/>
                    <TextBlock x:Name="MemoryNote" Style="{StaticResource Text.Label}" Margin="0,6,0,0"
                               Text="Share of your total system memory."/>
                </StackPanel>
            </Border>

            <!-- Session history -->
            <Border Style="{StaticResource Card.Hover}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource Text.H2}" Text="Recent sessions"/>
                        <TextBlock x:Name="SessionSummary" HorizontalAlignment="Right"
                                   Style="{StaticResource Text.Label}" Text="—"/>
                    </Grid>

                    <ItemsControl x:Name="SessionList" Focusable="False"
                                  AutomationProperties.Name="Recent play sessions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="{Binding When}"/>
                                    <TextBlock Text="{Binding Detail}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoSessions" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0"
                               Visibility="Collapsed"
                               Text="No sessions recorded yet. Leave this running in the background and play — anything over a minute is kept."/>
                </StackPanel>
            </Border>

            <!-- Change history -->
            <Border Style="{StaticResource Card.Hover}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource Text.H2}" Text="Changes made to this PC"/>
                        <Button Content="Clear history" Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Right" MinWidth="110" Padding="12,6"
                                Click="ClearHistory_Click"
                                AutomationProperties.Name="Clear the change history"
                                AutomationProperties.HelpText="Forgets the record only. It does not undo any change."/>
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,4"
                               Text="Kept across restarts, so you can always answer what this tool touched. Clearing the list forgets the record — it does not undo anything."/>

                    <ItemsControl x:Name="HistoryList" Focusable="False"
                                  AutomationProperties.Name="Change history">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.CardAlt}" CornerRadius="8"
                                        Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource Pill}" Padding="6,2" MinHeight="0"
                                                        Background="{DynamicResource Brush.Card}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="{DynamicResource Font.Small}"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Action}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding When}" HorizontalAlignment="Right"
                                                       Style="{StaticResource Text.Label}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Label}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Label}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoHistory" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0"
                               Visibility="Collapsed" Text="Nothing changed yet."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

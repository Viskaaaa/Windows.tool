<UserControl x:Class="RigBooster.Views.GameOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Game optimizer">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>

            <TextBlock Style="{StaticResource Text.H1}" Text="Game optimizer"/>
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,16"
                       Text="The original settings file is copied to a .bak before the first change, so Restore always works."/>

            <Border x:Name="StatusBox" Style="{StaticResource Pill}" Visibility="Collapsed"
                    Background="{DynamicResource Brush.CardAlt}" Margin="0,0,0,12" HorizontalAlignment="Left">
                <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Status"/>
            </Border>

            <!-- Preset picker -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="Preset"/>
                    <TextBlock x:Name="TierHint" Style="{StaticResource Text.Label}" Margin="0,2,0,10"
                               Text="Picked from your detected hardware. Override it if you disagree."/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LowRadio" Content="Low — most FPS" Margin="0,0,20,0" IsChecked="True"
                                     GroupName="Tier" AutomationProperties.Name="Low preset, highest frame rate"/>
                        <RadioButton x:Name="MediumRadio" Content="Medium — balanced" Margin="0,0,20,0"
                                     GroupName="Tier" AutomationProperties.Name="Medium preset, balanced"/>
                        <RadioButton x:Name="HighRadio" Content="High — best looking"
                                     GroupName="Tier" AutomationProperties.Name="High preset, best visuals"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Detected games -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Text.H2}" Text="Detected games"/>
                        <Button Content="Rescan" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                                MinWidth="90" Padding="12,6" Click="Rescan_Click"
                                AutomationProperties.Name="Rescan for installed games"/>
                    </Grid>

                    <ItemsControl x:Name="GameList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.CardAlt}" CornerRadius="8"
                                        Padding="14" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource Text.Label}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Restore" Style="{StaticResource Button.Ghost}"
                                                    MinWidth="100" Margin="0,0,10,0" Click="Restore_Click"
                                                    AutomationProperties.Name="Restore original settings for this game"/>
                                            <Button Content="Apply preset" Style="{StaticResource Button.Primary}"
                                                    MinWidth="130" Click="Apply_Click"
                                                    AutomationProperties.Name="Apply the selected preset to this game"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoGamesText" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0"
                               Visibility="Collapsed"
                               Text="No settings files found yet. Launch FiveM or GTA V once so the game writes its settings, then press Rescan."/>
                </StackPanel>
            </Border>

            <!-- Windows tweaks -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="Windows tweaks"/>
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,2,0,8"
                               Text="Optional, and nothing here is applied unless you tick it and press Apply."/>

                    <CheckBox x:Name="PowerCheck" Content="Set the power plan to High performance"
                              AutomationProperties.Name="Set the power plan to High performance"
                              AutomationProperties.HelpText="Stops the CPU dropping clocks mid-game. Uses more power on a laptop."/>
                    <CheckBox x:Name="GameModeCheck" Content="Turn on Windows Game Mode"
                              AutomationProperties.Name="Turn on Windows Game Mode"
                              AutomationProperties.HelpText="Tells Windows to deprioritise background work while a game is running."/>
                    <CheckBox x:Name="DvrCheck" Content="Turn off background game recording (Game DVR)"
                              AutomationProperties.Name="Turn off background game recording"
                              AutomationProperties.HelpText="Game DVR records in the background and costs frames on weak hardware."/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Undo tweaks" Style="{StaticResource Button.Ghost}" Margin="0,0,10,0"
                                Click="UndoTweaks_Click"
                                AutomationProperties.Name="Undo the Windows tweaks"/>
                        <Button Content="Apply tweaks" Style="{StaticResource Button.Primary}"
                                Click="ApplyTweaks_Click"
                                AutomationProperties.Name="Apply the ticked Windows tweaks"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

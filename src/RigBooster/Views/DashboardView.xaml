<UserControl x:Class="RigBooster.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>

            <!-- Header + tier badge -->
            <Grid Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Text.H1}" Text="Hardware detected" VerticalAlignment="Center"/>
                <Border x:Name="TierPill" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                        Background="{DynamicResource Brush.WarningBg}">
                    <TextBlock x:Name="TierText" Text="Detecting…" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Warning}"
                               AutomationProperties.Name="Performance tier"/>
                </Border>
            </Grid>

            <!-- GPU / RAM / CPU -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="GPU"/>
                        <TextBlock x:Name="GpuText" Style="{StaticResource Text.H2}" Margin="0,4,0,0" Text="…"
                                   AutomationProperties.Name="Graphics card"/>
                        <TextBlock x:Name="VramText" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="RAM"/>
                        <TextBlock x:Name="RamText" Style="{StaticResource Text.H2}" Margin="0,4,0,0" Text="…"
                                   AutomationProperties.Name="System memory"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="CPU"/>
                        <TextBlock x:Name="CpuText" Style="{StaticResource Text.H2}" Margin="0,4,0,0" Text="…"
                                   AutomationProperties.Name="Processor"/>
                        <TextBlock x:Name="CpuNameText" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FPS estimate -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="FPS estimate"/>
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,2,0,14"
                               Text="Estimated from your hardware and the settings applied — not a measurement."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="Before"/>
                            <TextBlock x:Name="BeforeText" Text="—" FontSize="{DynamicResource Font.Huge}"
                                       FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"
                                       AutomationProperties.Name="Estimated FPS before"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="&#x2192;" Margin="24,26,24,0"
                                   FontSize="{DynamicResource Font.H1}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="After"/>
                            <TextBlock x:Name="AfterText" Text="—" FontSize="{DynamicResource Font.Huge}"
                                       FontWeight="Bold" Foreground="{DynamicResource Brush.Success}"
                                       AutomationProperties.Name="Estimated FPS after"/>
                        </StackPanel>

                        <Border Grid.Column="4" x:Name="GainPill" Style="{StaticResource Pill}"
                                VerticalAlignment="Center" Background="{DynamicResource Brush.SuccessBg}">
                            <TextBlock x:Name="GainText" Text="—" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Success}"
                                       AutomationProperties.Name="Estimated gain"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="FpsNote" Style="{StaticResource Text.Label}" Margin="0,14,0,0"
                               Text="Apply a preset in Game optimizer to see the projected after figure."/>
                </StackPanel>
            </Border>

            <!-- Junk summary -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource Text.H2}" Text="Junk found"/>
                        <TextBlock x:Name="JunkTotal" HorizontalAlignment="Right" FontWeight="Bold"
                                   Text="Scanning…" AutomationProperties.Name="Total reclaimable space"/>
                    </Grid>

                    <ItemsControl x:Name="JunkList" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,1">
                                    <Border Background="{DynamicResource Brush.Border}" Height="1" VerticalAlignment="Bottom"/>
                                    <Grid Margin="0,10">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="ReviewButton" Content="Review and clean" Margin="0,16,0,0"
                            Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"
                            Click="Review_Click" IsEnabled="False"
                            AutomationProperties.Name="Review and clean, opens the cache cleaner"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

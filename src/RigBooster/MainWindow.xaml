<Window x:Class="RigBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rig Booster" Height="720" Width="1080" MinHeight="560" MinWidth="880"
        Background="{DynamicResource Brush.Window}"
        AutomationProperties.Name="Rig Booster main window">

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static NavigationCommands.GoToPage}" CommandParameter="3"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static NavigationCommands.GoToPage}" Executed="GoToPage_Executed"/>
    </Window.CommandBindings>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Sidebar}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.H1}" Margin="6,8,6,18"
                           Text="Rig booster" Foreground="{DynamicResource Brush.Accent}"/>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Label}" Margin="6,16,6,4"
                           x:Name="LicenseFooter" Text="Activated"/>

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged"
                         KeyboardNavigation.TabNavigation="Once"
                         AutomationProperties.Name="Main navigation">
                    <ListBoxItem Content="Dashboard"      AutomationProperties.Name="Dashboard, page 1 of 4. Shortcut Control 1."/>
                    <ListBoxItem Content="Cache cleaner"  AutomationProperties.Name="Cache cleaner, page 2 of 4. Shortcut Control 2."/>
                    <ListBoxItem Content="Game optimizer" AutomationProperties.Name="Game optimizer, page 3 of 4. Shortcut Control 3."/>
                    <ListBoxItem Content="License"        AutomationProperties.Name="License and appearance, page 4 of 4. Shortcut Control 4."/>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl x:Name="Host" Grid.Column="1" Margin="16,0,0,0"
                        AutomationProperties.Name="Page content"/>
    </Grid>
</Window>

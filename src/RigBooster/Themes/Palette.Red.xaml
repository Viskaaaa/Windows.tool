<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default theme: dark red surfaces, lighter red accent, light text, neutral grey for
         secondary text so it does not fight the red. All contrast ratios below are against
         the surface they are used on and are >= 4.5:1. -->

    <SolidColorBrush x:Key="Brush.Window"        Color="#1A0808"/>
    <SolidColorBrush x:Key="Brush.Sidebar"       Color="#2A0E0E"/>
    <SolidColorBrush x:Key="Brush.Card"          Color="#2E1010"/>
    <SolidColorBrush x:Key="Brush.CardAlt"       Color="#3A1414"/>
    <SolidColorBrush x:Key="Brush.Border"        Color="#4E1D1D"/>

    <SolidColorBrush x:Key="Brush.Accent"        Color="#E4544F"/>
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#F06B66"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#C43F3B"/>
    <SolidColorBrush x:Key="Brush.OnAccent"      Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Text"          Color="#F7EFEF"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B3A9A9"/>
    <SolidColorBrush x:Key="Brush.TextDisabled"  Color="#8A8080"/>

    <SolidColorBrush x:Key="Brush.Success"       Color="#6EE7A0"/>
    <SolidColorBrush x:Key="Brush.SuccessBg"     Color="#14371F"/>
    <SolidColorBrush x:Key="Brush.Warning"       Color="#F2C14E"/>
    <SolidColorBrush x:Key="Brush.WarningBg"     Color="#3D2E0C"/>
    <SolidColorBrush x:Key="Brush.Danger"        Color="#FF8A8A"/>

    <SolidColorBrush x:Key="Brush.Focus"         Color="#FFD9D7"/>

</ResourceDictionary>
